# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma.
# Local dev example (adjust user/password/db name to match your local Postgres):
DATABASE_URL="postgresql://postgres:password@localhost:5432/besttech_erp?schema=public"

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# Cookie name used to store the auth token.
COOKIE_NAME=besttech_token

# SameSite attribute for the auth cookie: lax | strict | none.
#   lax  - site and API share a domain (e.g. besttch.com + api.besttch.com). Default.
#   none - site is on a different domain from the API (e.g. *.netlify.app).
#          Requires COOKIE_SECURE=true and HTTPS; the server refuses to start otherwise.
COOKIE_SAMESITE=lax

# Send the cookie over HTTPS only. Defaults to true when NODE_ENV=production,
# false otherwise. Must be false for plain-http localhost.
COOKIE_SECURE=false

# Public URL of the frontend. Used to build links in emails
# (e.g. the password reset link: $APP_URL/reset-password?token=...).
APP_URL=http://localhost:5173

# Outgoing email (SMTP). Leave SMTP_HOST empty in local dev: emails,
# including password reset links, are then printed to the server console
# instead of being sent.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BestTech <no-reply@besttch.com>"

# Public URL of this API. Used to build links to uploaded files.
PUBLIC_API_URL=http://localhost:4000

# Folder for uploaded files (product images), served at /uploads.
# Git-ignored. Relative to the backend folder unless absolute.
UPLOAD_DIR=uploads

# Database for the integration tests (npm run test:integration). It is wiped
# and rebuilt from the migrations on every run, so never point it at real
# data. The name must contain "test" or the tests refuse to run.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/besttech_erp_test?schema=public"
